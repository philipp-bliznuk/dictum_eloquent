# syntax=docker/dockerfile:1

FROM oven/bun:1.4-alpine AS ui
WORKDIR /ui
COPY ui/package.json ui/bun.lock ./
# Low network concurrency: with a lockfile bun opens every tarball download at once (default 48)
# and NATed build VMs (podman machine) stall some of them for minutes. 8 streams finish in seconds.
# The cache mount makes rebuilds after a lockfile change near-instant.
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production --ignore-scripts --network-concurrency=8
COPY ui/ ./
RUN bun run build


FROM python:3.14-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-default-groups --no-install-project


FROM python:3.14-slim AS runtime
ARG APP_UID=1000
ARG APP_GID=1000
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=prod \
    DATA_DIR=/data \
    UI_DIST=/app/ui/dist \
    BIND=0.0.0.0:3000
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid app --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app /data \
    && chown -R app:app /app /data
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app app.py alembic.ini gunicorn.conf.py ./
COPY --chown=app:app dictum/ ./dictum/
COPY --chown=app:app migrations/ ./migrations/
COPY --chown=app:app docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --from=ui --chown=app:app /ui/dist ./ui/dist
RUN chmod +x /usr/local/bin/entrypoint.sh
# No USER here: the entrypoint aligns `app` with PUID/PGID, chowns /data and drops privileges.
# Rootless podman users may still pass --user / --userns=keep-id; the switch is then skipped.
VOLUME ["/data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${BIND##*:}/api/health" || exit 1
ENTRYPOINT ["entrypoint.sh"]
CMD ["gunicorn", "--config", "gunicorn.conf.py", "app:create_app()"]
