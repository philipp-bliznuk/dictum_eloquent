# local | test | prod
ENVIRONMENT=prod
# DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive)
LOG_LEVEL=INFO
# sqlite db + cached audio live here
DATA_DIR=/data
DATABASE_URL=sqlite+aiosqlite:////data/dictum.db
# gunicorn listen address (container only; compose maps 3000:3000)
BIND=0.0.0.0:3000
# uid/gid the container drops to after chowning /data (container only, root start)
PUID=1000
PGID=1000
# Host header allow-list, * = any. Separate with , ; or space; ports, schemes
# and quotes are stripped, *.lan matches a suffix. localhost / 127.0.0.1 / ::1
# are always accepted (healthcheck), so list only what you type in the browser,
# e.g. dictum.local,192.168.1.20
# Mandatory (not *) as soon as AWS credentials are set: there is no auth,
# so an open Host check lets any LAN device or rebinding page run paid calls.
ALLOWED_HOSTS=*

# Seconds allowed per upstream request (dictionaries, audio)
HTTP_TIMEOUT=10

# Merriam-Webster Collegiate (optional; enables lookup + pronunciation audio)
MW_API_KEY=
MW_BASE_URL=https://www.dictionaryapi.com/api/v3/references/collegiate/json/
MW_AUDIO_BASE_URL=https://media.merriam-webster.com/audio/prons/en/us/mp3/
# Keyless fallback dictionary
FREE_DICTIONARY_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en/

# AWS Bedrock (optional; both keys set = AI drafting on)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
